---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const stack = [
  { layer: 'Front-end', items: 'TypeScript, React, Next.js, Vite, Tailwind CSS' },
  { layer: 'Back-end', items: 'Supabase (Auth, Postgres, realtime), REST & WebSocket APIs, Node.js, middleware & OpenAPI contracts' },
  { layer: 'AI & automation', items: 'AI-assisted development workflow, programmatic content generation, scheduled publishing systems, Dependabot automation across 20 repos' },
  { layer: 'Testing / quality', items: 'Jest, Playwright, Vitest, Testing Library — 90%+ coverage on production work' },
  { layer: 'Shipping', items: 'GitHub Actions, Vercel / Cloudflare Pages, pnpm' },
];
---

<Base
  title="Kenn — Full-Stack, AI-Driven Developer in Tokyo"
  description="Full-stack, AI-driven developer in Tokyo. Developer at Japannext; builder of Kanji Daily and the automation systems behind it."
>
  <section class="pb-20 pt-16 sm:pt-24">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-panel px-4 py-1.5 text-xs font-medium uppercase tracking-[0.18em] text-fog">
      <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Tokyo, Japan
    </p>
    <h1 class="mt-8 font-display text-5xl font-bold leading-[1.04] tracking-tight sm:text-7xl">
      Full-stack,<br /><span class="text-gradient">AI-driven</span> developer.
    </h1>
    <p class="mt-7 max-w-xl text-lg leading-relaxed text-fog">
      I'm Kenn, a developer at Japannext. I build web products end-to-end — React/TypeScript
      front-ends, APIs and middleware, data — and automate them with AI-driven pipelines, like
      Kanji Daily, which publishes a new video to YouTube and Instagram every day without
      manual work.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="#work" class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-ink shadow-[0_8px_30px_rgba(232,179,75,0.25)] transition hover:brightness-110">View work</a>
      <a href="#contact" class="rounded-full border border-line bg-panel px-6 py-3 text-sm font-semibold transition-colors hover:border-fog">Contact</a>
    </div>
  </section>

  <section id="work" class="scroll-mt-24 border-t border-line-soft py-16">
    <div class="flex items-end justify-between gap-6">
      <div>
        <h2 class="font-display text-3xl font-semibold tracking-tight">Featured work</h2>
        <div class="rule mt-4 w-24"></div>
      </div>
      <span class="hidden text-sm text-faint sm:block">{work.length} case studies</span>
    </div>
    <div class="mt-10 grid gap-5">
      {work.map((entry, i) => (
        <a
          href={`/work/${entry.id}`}
          class="group relative overflow-hidden rounded-3xl border border-line bg-panel p-7 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/50 hover:bg-panel-2 hover:shadow-[0_20px_50px_rgba(0,0,0,0.45)] sm:p-8"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <span class="font-display text-sm font-semibold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-xs font-medium uppercase tracking-[0.14em] text-faint">{entry.data.period}</span>
          </div>
          <h3 class="mt-4 font-display text-2xl font-semibold tracking-tight transition-colors group-hover:text-accent sm:text-[1.7rem]">
            {entry.data.title}
          </h3>
          <p class="mt-3 max-w-2xl leading-relaxed text-fog">{entry.data.summary}</p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <li class="rounded-full border border-line bg-ink/60 px-3 py-1 text-xs text-fog">{tag}</li>
            ))}
          </ul>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            Read the case study <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="scroll-mt-24 border-t border-line-soft py-16">
    <h2 class="font-display text-3xl font-semibold tracking-tight">About</h2>
    <div class="rule mt-4 w-24"></div>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-fog">
      Full-stack developer based in Tokyo, working at Japannext Co., Ltd. I work across the
      stack — interfaces, APIs, databases, deployment — and I use AI tooling and automation as
      a core part of how I build, not an afterthought. Outside work I run Kanji Daily, a daily
      Japanese-learning series produced and published by a pipeline I designed.
    </p>
    {/* TODO(kenn): years of experience + Japannext start date go here when you want them public. */}
  </section>

  <section class="border-t border-line-soft py-16">
    <h2 class="font-display text-3xl font-semibold tracking-tight">Stack</h2>
    <div class="rule mt-4 w-24"></div>
    <dl class="mt-10 overflow-hidden rounded-3xl border border-line">
      {stack.map((row, i) => (
        <div class={`grid gap-1.5 bg-panel px-7 py-5 sm:grid-cols-[180px_1fr] sm:gap-6 ${i !== 0 ? 'border-t border-line-soft' : ''}`}>
          <dt class="font-display font-semibold">{row.layer}</dt>
          <dd class="leading-relaxed text-fog">{row.items}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-8 text-sm leading-relaxed text-faint">
      This site: Astro + MDX content collections — the right tool for a content site, ~0 KB of
      JavaScript by default. The move away from Next.js was a deliberate engineering choice, not
      a rewrite for its own sake.
    </p>
  </section>

  <section id="contact" class="border-t border-line-soft py-16">
    <h2 class="font-display text-3xl font-semibold tracking-tight">Contact</h2>
    <div class="rule mt-4 w-24"></div>
    <ul class="mt-8 space-y-3 text-lg">
      <li><a class="font-medium text-accent underline-offset-4 hover:underline" href="https://github.com/kennghuser">GitHub — @kennghuser</a></li>
      <li><a class="font-medium text-accent underline-offset-4 hover:underline" href="https://youtube.com/@kanjidaily">YouTube — Kanji Daily</a></li>
      {/* TODO(kenn): replace these placeholders with your real LinkedIn URL and public email. */}
      <li class="text-faint">LinkedIn — <span class="italic">link coming soon</span></li>
      <li class="text-faint">Email — <span class="italic">address coming soon</span></li>
      {/* TODO(kenn): add CV PDF link once the updated CV is ready. */}
    </ul>
  </section>
</Base>
