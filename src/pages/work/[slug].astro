---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Kenn`} description={entry.data.summary}>
  <article class="pb-20 pt-12">
    <a href="/#work" class="inline-flex items-center gap-1.5 text-sm font-medium text-fog transition-colors hover:text-accent">
      <span aria-hidden="true">←</span> All work
    </a>
    <h1 class="mt-8 font-display text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">{entry.data.title}</h1>
    <p class="mt-4 text-sm font-medium uppercase tracking-[0.14em] text-faint">{entry.data.role} · {entry.data.period}</p>
    <ul class="mt-7 flex flex-wrap gap-2">
      {entry.data.tags.map((tag: string) => (
        <li class="rounded-full border border-line bg-panel px-3 py-1 text-xs text-fog">{tag}</li>
      ))}
    </ul>
    <div class="rule mt-10 w-full opacity-40"></div>
    <div class="prose-custom mt-4">
      <Content />
    </div>
    {entry.data.links.length > 0 && (
      <div class="mt-14 rounded-3xl border border-line bg-panel p-7">
        <h2 class="font-display text-lg font-semibold">Links</h2>
        <ul class="mt-4 space-y-2.5">
          {entry.data.links.map((link: { label: string; href: string }) => (
            <li><a class="font-medium text-accent underline-offset-4 hover:underline" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Base>
