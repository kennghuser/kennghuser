---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Kenn`} description={entry.data.summary}>
  <article class="pb-16 pt-10">
    <a href="/#work" class="text-sm text-fog transition-colors hover:text-paper">← All work</a>
    <h1 class="mt-6 font-serif text-4xl leading-tight sm:text-5xl">{entry.data.title}</h1>
    <p class="mt-3 text-sm uppercase tracking-wider text-fog">{entry.data.role} · {entry.data.period}</p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {entry.data.tags.map((tag: string) => (
        <li class="rounded-full border border-line px-3 py-1 text-xs text-fog">{tag}</li>
      ))}
    </ul>
    <div class="prose-custom mt-10 space-y-5 leading-relaxed text-fog [&_h2]:pt-4 [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:text-paper [&_a]:text-accent [&_a]:underline-offset-4 [&_a:hover]:underline [&_strong]:text-paper [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:pl-6">
      <Content />
    </div>
    {entry.data.links.length > 0 && (
      <div class="mt-12 border-t border-line pt-8">
        <h2 class="text-sm uppercase tracking-[0.2em] text-fog">Links</h2>
        <ul class="mt-4 space-y-2">
          {entry.data.links.map((link: { label: string; href: string }) => (
            <li><a class="text-accent underline-offset-4 hover:underline" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Base>
